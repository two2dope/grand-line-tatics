# Normalize text to LF in the repository
* text=auto eol=lf

# Windows launchers keep CRLF
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.glb binary
*.mp4 binary
*.webm binary
*.wav binary

# Vendored, minified third-party code: no diffs, not counted in language stats
tools/vendor/** linguist-vendored -diff
legacy/** linguist-documentation
