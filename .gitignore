# ---------------------------------------------------------------------------
# Grand Line Tactics: what stays out of the repository
# ---------------------------------------------------------------------------

# Dependencies
node_modules/

# Build outputs (regenerate with `npm run build` and `npm run build:artifact`)
/index.html
/grand-line-tactics.html
/dist/

# Working screenshots from critic runs, baselines and smoke tests
# (curated images for the README live in docs/media/)
/shots/

# Third-party reference material: copyrighted, never published
/ref/

# Internal process dashboard used during the build loop
/progress/

# Unused GLB models inherited from the pilot (not loaded by the game; license check pending)
/assets/models/

# Generated by the headless simulation (regenerate with `npm run test:sim`)
/tests/sim-report.json

# Throwaway debug scripts
/tools/_dbg_*.mjs

# Local editor and workspace files (may point to folders outside the repo)
*.code-workspace
.vscode/
.idea/

# Secrets and local environment (never commit)
.env
.env.*
*.pem
*.key
*.p12
*.pfx
id_rsa*
*.secret

# Logs and OS clutter
*.log
npm-debug.log*
.DS_Store
Thumbs.db
desktop.ini

# Legacy test outputs
/legacy/tests/out/

# Service worker generated by scripts/build.js from src/sw/sw.js
/sw.js
